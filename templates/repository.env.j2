RESTIC_REPOSITORY={{ item.repository | quote }}
RESTIC_PASSWORD_FILE={{ item.password_file | quote }}
{% if item.repository.startswith('s3:') %}{% if item.s3_access_key | length > 0 %}AWS_ACCESS_KEY_ID={{ item.s3_access_key | quote }}
{% endif %}{% if item.s3_secret_key | length > 0 %}AWS_SECRET_ACCESS_KEY={{ item.s3_secret_key | quote }}
{% endif %}{% if item.s3_session_token | length > 0 %}AWS_SESSION_TOKEN={{ item.s3_session_token | quote }}
{% endif %}{% if item.s3_region | length > 0 %}AWS_DEFAULT_REGION={{ item.s3_region | quote }}
{% endif %}{% endif %}
